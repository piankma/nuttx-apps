#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LIB_SQLITE
	bool "SQLITE library"
	depends on FS_LOCK_BUCKET_SIZE > 0
	default n

if LIB_SQLITE

config LIB_SQLITE_VERSION
	string "SQLITE version"
	default "3.45.1"

config LIB_SQLITE_YEAR
	string "SQLITE release year"
	default "2024"
	---help---
		The year of the version's release: sqlite.org keeps its
		amalgamations under it (www.sqlite.org/<year>/).  Used when
		there is no git checkout in sqlite/.

config LIB_SQLITE_SMALL
	bool "Leave out rarely used parts"
	default n
	---help---
		Build without loadable extensions, deprecated and shared-cache
		interfaces, JSON, WAL, UTF-16, memory-mapped I/O and the
		progress and trace callbacks, and keep temporary tables in
		memory.  Saves flash on small systems.

config UTILS_SQLITE
	tristate "SQLite cmd line tool"
	default n

config UTILS_SQLITE_STACKSIZE
	int "SQLite3 cmd line tool stack size"
	default 8192
	depends on UTILS_SQLITE

endif
